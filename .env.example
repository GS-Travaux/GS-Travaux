# ───────── Navigateur (publiques : visibles dans le code envoyé aux visiteurs) ─────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...clé-anon-public...

# ───────── Serveur uniquement (Vercel → Settings → Environment Variables) ─────────
# NE JAMAIS préfixer par VITE_ : ces valeurs ne doivent jamais atteindre le navigateur.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...clé-service_role-secrète...
# Clé « anon » côté serveur : sert uniquement à ouvrir la session du propriétaire (même valeur que VITE_SUPABASE_ANON_KEY).
SUPABASE_ANON_KEY=eyJ...clé-anon-public...
# Compte propriétaire de la plateforme (gère les entreprises clientes et les licences)
OWNER_EMAIL=vous@exemple.com
# (8 caractères minimum ; l'adresse OWNER_EMAIL doit être réservée au propriétaire, pas celle d'un compte d'entreprise)
OWNER_PASSWORD=choisir-un-mot-de-passe-long-et-unique
# Adresse publique de l'application, utilisée dans les liens des e-mails de réinitialisation de mot de passe.
# Facultatif : à défaut, l'adresse du site qui reçoit la requête est utilisée. Elle doit aussi figurer dans
# Supabase → Authentication → URL Configuration (Site URL / Redirect URLs).
# PUBLIC_APP_URL=https://votre-application.vercel.app
